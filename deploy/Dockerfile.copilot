# syntax=docker/dockerfile:1
FROM rust:1.99.1-bookworm AS build
ARG BUILD_JOBS=2
WORKDIR /build
COPY src/copilot-api-proxy/ ./
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --locked --release --jobs "$BUILD_JOBS"

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 proxy \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/proxy proxy \
    && chmod 700 /home/proxy
COPY --from=build /build/target/release/copilot-api-proxy /usr/local/bin/copilot-api-proxy
COPY src/copilot-api-proxy/LICENSE /licenses/copilot-api-proxy-LICENSE
USER 10001:10001
WORKDIR /home/proxy
EXPOSE 9876
ENTRYPOINT ["/usr/local/bin/copilot-api-proxy"]
CMD ["server", "--host", "0.0.0.0", "--port", "9876"]

